# Git / VCS
.git
.gitignore
.gitattributes

# Python 缓存
__pycache__
*.pyc
*.pyo
# 本地 Cython 编译产物（开源发布脚手架生成）：禁止进镜像，
# 否则 .so 会遮蔽同名 .py 源码（Python 优先加载扩展模块），导致新代码不生效
*.so
*.pyd
*.egg-info
.venv
venv
.pytest_cache
.mypy_cache
.ruff_cache
htmlcov
.coverage
coverage.xml

# Node（前端构建产物不需要进后端构建上下文）
node_modules
dist

# IDE / 编辑器
.vscode
.idea
.trae
*.swp
*.swo

# 环境变量 / 密钥
.env
.env.*

# OS
Thumbs.db
.DS_Store

# 临时 / 日志
*.log
tmp
tmp-*
debug_pw.py
*.bak
